# Environment Variables for Local Development
# Copy this to .env and set your values

# JWT Secret Key (minimum 32 characters for HS256)
JWT_SECRET=YourSecureJWTSecretKeyMinimum32CharactersLongForHS256Algorithm

# Database Configuration (optional - defaults in application.properties)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=disputehub
# DB_USERNAME=postgres
# DB_PASSWORD=password

# CORS Origins (optional)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
